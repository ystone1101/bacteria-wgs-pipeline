// Personal Nextflow port of bacteria_wgs_pipeline.sh
// Modes: short, long_np, long_pb, hybrid_np, hybrid_pb

params {
    mode   = null
    input  = null   // samplesheet CSV: sample,fastq_1,fastq_2,long_reads
    outdir = 'results'
    threads = 4

    adapter               = null   // Trimmomatic adapter FASTA (short/hybrid_*)
    bakta_db              = null   // Bakta database dir (every mode, unless --skip_bakta)
    min_length            = 1000
    // No tmp_dir param: unlike the bash script (one shared TMP_DIR, fine
    // since samples run sequentially), each BAKTA task here uses its own
    // per-task "tmp/" inside the Nextflow work dir, which stays safe when
    // samples run in parallel.

    filtlong_min_length   = 1000
    filtlong_keep_percent = 90
    flye_read_type        = '--nano-hq'   // long_np
    flye_pacbio_read_type = '--pacbio-hifi' // long_pb
    medaka_model          = null          // long_np, no safe default

    skip_checkm = false
    skip_bakta  = false
}

process {
    cpus = params.threads
}

profiles {
    conda {
        conda.enabled = true
        // Reuse the same env as the bash pipeline (../environment.yml)
        process.conda = "${projectDir}/../environment.yml"
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

manifest {
    name            = 'bacteria-wgs-pipeline (nextflow)'
    description     = 'Bacterial WGS assembly & annotation: short / long_np / long_pb / hybrid_np / hybrid_pb'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}
